@page "/reports"



@inject FoodOrdersClient OrdersClient
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>Reports</PageTitle>

<h3>Orders Report</h3>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <label class="form-label">Start Date</label>
        <InputDate @bind-Value="startDate" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">End Date</label>
        <InputDate @bind-Value="endDate" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Page Size</label>
        <InputNumber @bind-Value="pageSize" class="form-control" />
    </div>
    <div class="col-md-4 d-flex align-items-end gap-2">
        <button class="btn btn-primary" @onclick="RefreshReport">Load</button>
        <button class="btn btn-outline-secondary" @onclick="DownloadExcel">Download Excel</button>
        <button class="btn btn-outline-secondary" @onclick="DownloadPdf">Download PDF</button>
    </div>
</div>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Date</th>
            <th>Customer Name</th>
            <th>Location</th>
            <th>Meal Type</th>
            <th>Type</th>
            <th>Status</th>
            <th class="text-end">Price</th>
        </tr>
    </thead>
    <tbody>
        @{ var items = report?.Items ?? Array.Empty<FoodOrderDto>(); }
        @if (items.Count == 0)
        {
            <tr><td colspan="7">No data.</td></tr>
        }
        else
        {
            @foreach (var order in items)
            {
                <tr>
                    <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td>@order.CustomerName</td>
                    <td>@order.Location</td>
                    <td>@order.MealType</td>
                    <td>@order.MealOption</td>
                    <td>@order.Status</td>
                    <td class="text-end">@order.TotalAmount.ToString("C2")</td>
                </tr>
            }
        }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>Page @currentPage of @totalPages</div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary btn-sm" @onclick="PrevPage" disabled="@(currentPage <= 1)">Prev</button>
        <button class="btn btn-outline-primary btn-sm" @onclick="NextPage" disabled="@(report is null || currentPage >= totalPages)">Next</button>
    </div>
</div>

<div class="fw-bold text-end">Total (this page): @pageTotal.ToString("C2")</div>

@code {
    private DateOnly? startDate = DateOnly.FromDateTime(DateTime.Today.AddMonths(-1));
    private DateOnly? endDate = DateOnly.FromDateTime(DateTime.Today);
    private int currentPage = 1;
    private int pageSize = 20;
    private PagedResult<FoodOrderDto>? report;
    private decimal pageTotal;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadReport();
    }

    private async Task RefreshReport()
    {
        currentPage = 1;
        await LoadReport();
    }

    private async Task LoadReport()
    {
        pageSize = Math.Max(1, pageSize);
        report = await OrdersClient.GetReportAsync(startDate, endDate, currentPage, pageSize);
        var items = report?.Items ?? Array.Empty<FoodOrderDto>();
        pageTotal = items.Sum(o => o.TotalAmount);
        totalPages = Math.Max(1, (int)Math.Ceiling((double)(report?.TotalCount ?? 0) / pageSize));
        currentPage = Math.Min(currentPage, totalPages);
    }

    private async Task PrevPage()
    {
        if (currentPage <= 1)
        {
            return;
        }

        currentPage--;
        await LoadReport();
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages)
        {
            return;
        }

        currentPage++;
        await LoadReport();
    }

    private async Task DownloadExcel()
    {
        var url = BuildExportUrl("excel");
        var fileName = $"orders-{DateTime.UtcNow:yyyyMMddHHmmss}.xlsx";
        await JS.InvokeVoidAsync("downloadFile", url, fileName);
    }

    private async Task DownloadPdf()
    {
        var url = BuildExportUrl("pdf");
        var fileName = $"orders-{DateTime.UtcNow:yyyyMMddHHmmss}.pdf";
        await JS.InvokeVoidAsync("downloadFile", url, fileName);
    }

    private string BuildExportUrl(string format)
    {
        var qs = new List<string>();
        if (startDate.HasValue)
        {
            qs.Add($"startDate={Uri.EscapeDataString(startDate.Value.ToString("yyyy-MM-dd"))}");
        }
        if (endDate.HasValue)
        {
            qs.Add($"endDate={Uri.EscapeDataString(endDate.Value.ToString("yyyy-MM-dd"))}");
        }

        var suffix = qs.Count > 0 ? "?" + string.Join("&", qs) : string.Empty;
        var path = $"api/foodorders/export/{format}{suffix}";

        if (OrdersClient.BaseAddress is { } baseAddress)
        {
            return new Uri(baseAddress, path).ToString();
        }

        return "/" + path;
    }
}
