@page "/orders"



@inject FoodOrdersClient OrdersClient

<PageTitle>Orders</PageTitle>

<div class="d-flex align-items-end gap-3 mb-3">
	<div>
		<label class="form-label">Month</label>
		<InputDate @bind-Value="selectedDate" class="form-control" />
	</div>
	<button class="btn btn-primary" @onclick="LoadOrders">Load</button>
	<span class="text-muted">Showing @selectedDate.ToString("MMMM yyyy")</span>
</div>

<table class="table table-striped table-sm">
	<thead>
		<tr>
			<th>Date</th>
			<th>Customer Name</th>
			<th>Location</th>
			<th>Type</th>
			<th>Status</th>
			<th class="text-end">Price</th>
		</tr>
	</thead>
	<tbody>
		@if (orders.Count == 0)
		{
			<tr><td colspan="6">No orders found.</td></tr>
		}
		else
		{
			@foreach (var order in orders)
			{
				<tr>
					<td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
					<td>@order.CustomerName</td>
					<td>@order.Location</td>
					<td>@order.MealType / @order.MealOption</td>
					<td>@order.Status</td>
					<td class="text-end">@order.TotalAmount.ToString("C2")</td>
				</tr>
			}
		}
	</tbody>
</table>

<div class="d-flex justify-content-end fw-bold">Total: @totalAmount.ToString("C2")</div>

@code {
	private DateTime selectedDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
	private List<FoodOrderDto> orders = new();
	private decimal totalAmount;

	protected override async Task OnInitializedAsync()
	{
		await LoadOrders();
	}

	private async Task LoadOrders()
	{
		var month = selectedDate.Month;
		var year = selectedDate.Year;
		orders = await OrdersClient.GetMonthlyAsync(year, month);
		totalAmount = orders.Sum(o => o.TotalAmount);
	}
}
